<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Configuración de seguridad de red restrictiva para pruebas locales de rendimiento.
      Permite tráfico HTTP en texto claro ÚNICAMENTE hacia los hosts locales de prueba:
      - 10.0.2.2: IP especial que usa el emulador Android para acceder al localhost del PC host.
      - localhost y 127.0.0.1: para pruebas locales directas.
      
      Si se realizan pruebas con un teléfono físico conectado por Wi-Fi a la misma red LAN:
      descomentar o agregar la IP local de tu PC (ej: <domain includeSubdomains="false">192.168.1.100</domain>).
      
      Cualquier otra conexión externa que use HTTP en texto claro es BLOQUEADA.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- Bloqueo global de HTTP para todos los demás dominios -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
